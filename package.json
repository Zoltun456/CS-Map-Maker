{
  "name": "cs-map-maker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "map": "tsx src/cli/index.ts",
    "map:validate": "tsx src/cli/index.ts validate",
    "map:analyze": "tsx src/cli/index.ts analyze",
    "map:simulate": "tsx src/cli/index.ts simulate",
    "map:evaluate": "tsx src/cli/index.ts evaluate",
    "map:render": "tsx src/cli/index.ts render",
    "map:compare": "tsx src/cli/index.ts compare",
    "agent:trial": "tsx scripts/agent-trial.ts",
    "test:cli": "tsx src/cli/index.ts validate examples/maps/two-site.csmap.json --json && tsx src/cli/index.ts validate examples/maps/layered-two-site.v2.csmap.json --json",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:cli && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
