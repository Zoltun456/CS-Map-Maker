{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoltun456.github.io/CS-Map-Maker/schema/map-operations.schema.json",
  "title": "CS Map Maker immutable operations",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "required": ["type", "cells", "tile"],
        "properties": {
          "type": { "const": "paint" },
          "cells": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
          "tile": { "type": "integer", "minimum": 0, "maximum": 7 },
          "brushSize": { "type": "integer", "minimum": 1 }
        }
      },
      {
        "type": "object",
        "required": ["type", "from", "to", "tile"],
        "properties": {
          "type": { "const": "rectangle" },
          "from": { "$ref": "#/$defs/point" },
          "to": { "$ref": "#/$defs/point" },
          "tile": { "type": "integer", "minimum": 0, "maximum": 7 }
        }
      },
      {
        "type": "object",
        "required": ["type", "from", "to", "width"],
        "properties": {
          "type": { "const": "corridor" },
          "from": { "$ref": "#/$defs/point" },
          "to": { "$ref": "#/$defs/point" },
          "width": { "type": "integer", "minimum": 1 }
        }
      },
      {
        "type": "object",
        "required": ["type", "axis"],
        "properties": {
          "type": { "const": "mirror" },
          "axis": { "enum": ["horizontal", "vertical"] }
        }
      },
      {
        "type": "object",
        "required": ["type", "from", "to"],
        "properties": {
          "type": { "const": "replace" },
          "from": { "type": "integer", "minimum": 0, "maximum": 7 },
          "to": { "type": "integer", "minimum": 0, "maximum": 7 }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "levelId", "cells", "geometry"],
        "properties": {
          "type": { "const": "paint-geometry" },
          "levelId": { "type": "string", "minLength": 1 },
          "cells": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/point" } },
          "geometry": { "enum": ["void", "floor", "wall", "full-cover", "half-cover"] }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "levelId"],
        "properties": {
          "type": { "const": "set-level" },
          "levelId": { "type": "string", "minLength": 1 },
          "elevation": { "type": "integer", "minimum": -4096, "maximum": 4096 },
          "ceilingHeight": { "type": "integer", "minimum": 64, "maximum": 1024 }
        },
        "anyOf": [{ "required": ["elevation"] }, { "required": ["ceilingHeight"] }]
      }
    ]
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": { "x": { "type": "integer" }, "y": { "type": "integer" } }
    }
  }
}
