{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoltun456.github.io/CS-Map-Maker/schema/csmap-v2.schema.json",
  "title": "CS Map Maker layered map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "name",
    "profile",
    "width",
    "height",
    "cellSize",
    "levels",
    "zones",
    "features",
    "links"
  ],
  "properties": {
    "format": { "const": "cs-map-maker" },
    "version": { "const": 2 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "notes": { "type": "string", "maxLength": 4000 },
    "profile": { "enum": ["two-site-3v3", "one-site-3v3"] },
    "width": { "type": "integer", "minimum": 1, "maximum": 96 },
    "height": { "type": "integer", "minimum": 1, "maximum": 96 },
    "cellSize": { "const": 64 },
    "levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/level" }
    },
    "zones": { "type": "array", "items": { "$ref": "#/$defs/zone" } },
    "features": { "type": "array", "items": { "$ref": "#/$defs/feature" } },
    "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "designTargets": {
      "type": "object",
      "description": "Display-only design notes; never modifies official grading."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["levelId", "x", "y"],
      "properties": {
        "levelId": { "$ref": "#/$defs/id" },
        "x": { "type": "integer", "minimum": 0, "maximum": 95 },
        "y": { "type": "integer", "minimum": 0, "maximum": 95 }
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "elevation", "ceilingHeight", "rows"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "elevation": { "type": "integer", "minimum": -4096, "maximum": 4096, "multipleOf": 16 },
        "ceilingHeight": { "type": "integer", "minimum": 64, "maximum": 1024, "multipleOf": 16 },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 96,
          "items": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[_\\.#Xx]+$" }
        }
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "cells"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": ["t-spawn", "ct-spawn", "site-a", "site-b", "indoor", "callout", "material"]
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "material": { "type": "string", "minLength": 1, "maxLength": 80 },
        "cells": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/point" } }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "from", "to"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["door", "window", "railing", "one-way-sight"] },
        "from": { "$ref": "#/$defs/point" },
        "to": { "$ref": "#/$defs/point" },
        "open": { "type": "boolean" }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "from", "to", "bidirectional"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["stairs", "ramp", "ladder", "drop", "boost"] },
        "from": { "$ref": "#/$defs/point" },
        "to": { "$ref": "#/$defs/point" },
        "bidirectional": { "type": "boolean" }
      }
    }
  }
}
