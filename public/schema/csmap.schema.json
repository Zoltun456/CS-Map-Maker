{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoltun456.github.io/CS-Map-Maker/schema/csmap.schema.json",
  "title": "CS Map Maker agent map",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "name", "profile", "width", "height", "rows"],
  "properties": {
    "format": { "const": "cs-map-maker" },
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" },
    "profile": { "enum": ["two-site-3v3", "one-site-3v3"] },
    "width": { "type": "integer", "minimum": 1, "maximum": 96 },
    "height": { "type": "integer", "minimum": 1, "maximum": 96 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 96,
      "items": { "type": "string", "pattern": "^[#.XTCABI]+$" }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tWinRate": { "$ref": "#/$defs/range" },
        "firstContactSeconds": { "$ref": "#/$defs/range" },
        "ctLeadSeconds": { "$ref": "#/$defs/range" },
        "rotationSeconds": { "$ref": "#/$defs/range" },
        "maxSightlineUnits": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  },
  "$defs": {
    "range": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    }
  }
}
